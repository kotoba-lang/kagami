{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; TEST-ONLY: the compiler and the KIR interpreter exist
                      ;; here so `kagami.pin-kotoba-parity-test` can compile
                      ;; `src/kagami/pin_core.kotoba` at test time and run it
                      ;; against `kagami.pin`. Nothing at runtime loads either:
                      ;; the production entry point stays
                      ;; `nbb --classpath src bin/kagami.cljs`, and keeping
                      ;; that contract unchanged is why the `.kotoba` core is
                      ;; parity-bound rather than authoritative in this slice
                      ;; (see the header of pin_core.kotoba).
                      ;;
                      ;; Pinned as a matched pair: this kotoba-kir sha is the
                      ;; one amu@dd943e08's own deps.edn names — an interpreter
                      ;; reading a shape its emitter did not write is exactly
                      ;; the drift this pinning removes. Advance them together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "dd943e084e8189f4b399b51fe88f1227baba5b1e"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "fdf407a6645d7d35af8b6fd8ffb69d948bfe2aa8"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
