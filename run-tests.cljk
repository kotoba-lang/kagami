#!/usr/bin/env nbb
;; nbb --classpath src:test run-tests.cljk
(ns run-tests
  (:require [cljs.test :refer [run-tests]]
            [kagami.core-test]))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (when-not (cljs.test/successful? m)
    (js/process.exit 1)))

(run-tests 'kagami.core-test)
