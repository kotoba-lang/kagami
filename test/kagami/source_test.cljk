(ns kagami.source-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kagami.source :as s]))

(def old (apply str (repeat 40 "a")))
(def new (apply str (repeat 40 "b")))
(def digest (s/content-cid "fixture"))
(defn repo [name]
  {:repo/id (str "acme/" name) :repo/name name :repo/path (str "acme/" name)
   :repo/url (str "https://github.com/acme/" name ".git")
   :repo/oid {:algorithm :sha1 :hex old} :repo/materialization :git})
(def base-value
  {:snapshot/parent nil :snapshot/basis old :snapshot/registry digest :snapshot/lock digest
   :snapshot/graph {"acme/app" ["acme/lib"] "acme/lib" []}
   :snapshot/repos [(repo "app") (repo "lib")]})
(def base (s/record :snapshot base-value))
(def change (s/record :change {:change/id "task-1" :change/actor "did:key:fixture"
                              :change/title "Change app and lib" :change/repos ["acme/app" "acme/lib"]}))
(def revision-value
  {:revision/change "task-1" :revision/base (:source/cid base) :revision/parent nil
   :revision/actor "did:key:fixture" :revision/op-heads []
   :revision/changes [{:repo/id "acme/lib" :revision/old {:algorithm :sha1 :hex old}
                       :revision/new {:algorithm :sha1 :hex new}}]})

(defn reason [f]
  (try (f) nil (catch #?(:clj Exception :cljs :default) e (:reason (ex-data e)))))

(deftest immutable-identities-and-substitution
  (is (s/cid? digest))
  (is (= (s/value-cid {:a 1 :b [2 3]}) (s/value-cid (array-map :b [2 3] :a 1))))
  (is (not= (s/value-cid {:a 1}) (s/value-cid [:map [[:a 1]]])))
  (is (= base (s/verify! base)))
  (is (= :cid-mismatch (reason #(s/verify! (assoc-in base [:source/value :snapshot/basis] new)))))
  (is (= :invalid-fields (reason #(s/verify! (assoc base :silently-ignored true)))))
  (is (= :unsupported-record-version (reason #(s/verify! (assoc base :source/version 2)))))
  (is (= :unsupported-value (reason #(s/value-cid {:float 0.5})))))

(deftest snapshot-is-a-complete-validated-version-set
  (is (= ["acme/app" "acme/lib"] (s/closure base ["acme/app"])))
  (is (= ["acme/lib"] (s/closure base ["acme/lib"])))
  (is (= :invalid-or-duplicate-items (reason #(s/closure base ["acme/missing"]))))
  (is (= :incomplete-dependency-graph
         (reason #(s/record :snapshot (update base-value :snapshot/graph dissoc "acme/lib")))))
  (is (= :invalid-or-duplicate-items
         (reason #(s/record :snapshot (assoc-in base-value [:snapshot/graph "acme/app"] ["acme/missing"])))))
  (is (= :duplicate-repository
         (reason #(s/record :snapshot (update base-value :snapshot/repos conj (repo "app"))))))
  (is (= :invalid-repository
         (reason #(s/record :snapshot (assoc-in base-value [:snapshot/repos 0 :repo/path] "../outside")))))
  (is (= :unsupported-git-oid
         (reason #(s/record :snapshot (assoc-in base-value [:snapshot/repos 0 :repo/oid :hex] "abc"))))))

(deftest revisions-bind-exact-base-and-scope
  (let [r (s/make-revision change base revision-value) candidate (s/candidate base r)]
    (is (= (:source/cid base) (get-in candidate [:source/value :snapshot/parent])))
    (is (= new (get-in candidate [:source/value :snapshot/repos 1 :repo/oid :hex])))
    (is (= old (get-in candidate [:source/value :snapshot/repos 0 :repo/oid :hex])))
    (is (= :revision-scope-or-old-mismatch
           (reason #(s/make-revision change base (assoc-in revision-value [:revision/changes 0 :revision/old :hex] (apply str (repeat 40 "c")))))))
    (is (= :revision-base-mismatch
           (reason #(s/candidate candidate r))))))
